{
    "transaction_id": {
        "importance_weight": 0.1,
        "behaviour_rules": [
            "duplicate transaction_id across records"
        ]
    },
    "booking_jurisdiction": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "jurisdiction with high AML scrutiny (e.g., CH, SG, HK)"
        ]
    },
    "regulator": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "regulator mismatch with jurisdiction"
        ]
    },
    "booking_datetime": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "transactions occurring outside business hours",
            "sudden spikes in volume within short time"
        ]
    },
    "value_date": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "value_date far from booking_datetime (>2 days)"
        ]
    },
    "amount": {
        "importance_weight": 0.95,
        "behaviour_rules": [
            "amount > 500,000 in any currency",
            "amount > 1,000,000 for high-risk product types"
        ]
    },
    "currency": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "use of exotic currencies (CNY, JPY) with large amounts",
            "currency mismatch with fx_indicator"
        ]
    },
    "channel": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "use of FAST (SG) or RTGS for cash deposits",
            "channel not typical for product_type"
        ]
    },
    "product_type": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "product_type = fx_conversion or securities_trade with high amount",
            "cash_deposit via wire_transfer"
        ]
    },
    "originator_name": {
        "importance_weight": 0.2,
        "behaviour_rules": [
            "repeated originator_name across many high-value transactions"
        ]
    },
    "originator_account": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "originator_account appearing in multiple beneficiary roles"
        ]
    },
    "originator_country": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "originator_country high-risk (IR, RU, CN) with large transfers"
        ]
    },
    "beneficiary_name": {
        "importance_weight": 0.2,
        "behaviour_rules": [
            "beneficiary_name reused across unrelated customers"
        ]
    },
    "beneficiary_account": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "beneficiary_account linked to many originators"
        ]
    },
    "beneficiary_country": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "beneficiary_country high-risk (IR, RU, CN) with cross-border flow"
        ]
    },
    "swift_mt": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "missing MT code for wire transfers"
        ]
    },
    "ordering_institution_bic": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "BIC not matching booking_jurisdiction"
        ]
    },
    "beneficiary_institution_bic": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "BIC not matching beneficiary_country"
        ]
    },
    "swift_f50_present": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "false for high-value SWIFT messages"
        ]
    },
    "swift_f59_present": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "false for high-value SWIFT messages"
        ]
    },
