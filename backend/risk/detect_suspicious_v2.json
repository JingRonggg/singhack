        ]
    },
    "fx_base_ccy": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "base currency does not match transaction currency"
        ]
    },
    "fx_quote_ccy": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "quote currency unusual for the pair"
        ]
    },
