        ]
    },
    "fx_counterparty": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "counterparty unknown or blank"
        ]
    },
    "customer_id": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "customer_id linked to many high-value transactions"
        ]
    },
    "customer_type": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "domiciliary_company flagged more often than individual"
        ]
    },
    "customer_risk_rating": {
        "importance_weight": 0.9,
        "behaviour_rules": [
            "rating = High or Medium combined with large amount"
        ]
    },
    "customer_is_pep": {
        "importance_weight": 0.95,
        "behaviour_rules": [
            "PEP flag true with any high-value transaction"
        ]
    },
    "kyc_last_completed": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "last KYC date older than 2 years"
        ]
    },
    "kyc_due_date": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "kyc_due_date passed and not refreshed"
        ]
    },
    "edd_required": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "edd_required = true but edd_performed = false"
        ]
    },
    "edd_performed": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "edd_performed = false when edd_required = true"
        ]
    },
    "sow_documented": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "source of wealth not documented for large transfers"
        ]
    },
    "purpose_code": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "purpose_code generic (e.g., MED, INV) for high amount"
        ]
    },
    "narrative": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "narrative contains unrelated or filler text"
        ]
    },
    "is_advised": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "is_advised = false for complex products"
        ]
    },
    "product_complex": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "product_complex = true with cash deposits"
        ]
    },
    "client_risk_profile": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "profile = High combined with high amount"
        ]
    },
    "suitability_assessed": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "suitability_assessed = false for high-risk products"
        ]
    },
    "suitability_result": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "result = mismatch with product risk"
        ]
    },
    "product_has_va_exposure": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "true for non-VA products"
        ]
    },
    "va_disclosure_provided": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "false when product_has_va_exposure = true"
        ]
    },
    "cash_id_verified": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "false for cash deposits above 10,000"
        ]
    },
    "daily_cash_total_customer": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "daily total > 200,000 for a single customer"
        ]
    },
    "daily_cash_txn_count": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "more than 3 cash transactions in a single day"
        ]
    },
    "sanctions_screening": {
        "importance_weight": 0.95,
        "behaviour_rules": [
            "screening result = potential or match with high-risk entities"
        ]
    },
    "suspicion_determined_datetime": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "suspicion timestamp close to booking time (<1 hour)"
        ]
    },
    "str_filed_datetime": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "SAR filed date delayed > 48 hours after suspicion"
        ]
    },
    "large_amount_cross_border": {
        "importance_weight": 0.96,
        "behaviour_rules": [
            "amount > 500000 and originator_country != beneficiary_country"
        ]
    },
    "stale_kyc": {
        "importance_weight": 0.88,
        "behaviour_rules": [
            "kyc_due_date < today and kyc_last_completed < kyc_due_date"
        ]
    },
    "missing_edd": {
        "importance_weight": 0.82,
        "behaviour_rules": [
            "edd_required = true and edd_performed = false"
        ]
    },
    "high_fx_spread": {
        "importance_weight": 0.84,
        "behaviour_rules": [
            "fx_spread_bps > 50"
        ]
    },
    "multiple_transactions_same_day": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "daily_cash_txn_count > 3 or daily_cash_total_customer > 200000"
        ]
    },
    "high_risk_customer": {
        "importance_weight": 0.92,
        "behaviour_rules": [
            "customer_risk_rating in ['High','Medium'] and customer_is_pep = true"
        ]
    },
    "suspicious_product_channel": {
        "importance_weight": 0.87,
        "behaviour_rules": [
            "product_type in ['fx_conversion','securities_trade'] and channel in ['FAST (SG)','RTGS'] and amount > 1000000"
        ]
    },
    "inconsistent_currency_fx": {
        "importance_weight": 0.78,
        "behaviour_rules": [
            "fx_indicator = true and fx_base_ccy != currency"
        ]
    }
}