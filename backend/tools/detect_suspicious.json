{
    "transaction_id": {
        "importance_weight": 0.1,
        "behaviour_rules": [
            "duplicate transaction_id across records",
            "transaction_id pattern indicating synthetic IDs"
        ]
    },
    "booking_jurisdiction": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "jurisdiction with historically high SAR rates",
            "jurisdiction mismatch with originator_country or beneficiary_country"
        ]
    },
    "regulator": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "regulator not matching booking_jurisdiction",
            "regulator missing for high-risk product types"
        ]
    },
    "booking_datetime": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "transactions occurring outside business hours for the jurisdiction",
            "multiple transactions from same originator within minutes"
        ]
    },
    "value_date": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "value_date earlier than booking_datetime",
            "value_date far in future (>30 days) for cash deposits"
        ]
    },
    "amount": {
        "importance_weight": 0.95,
        "behaviour_rules": [
            "amount exceeds jurisdiction-specific threshold (e.g., > 1,000,000)",
            "amount unusually high for product_type (cash_deposit, cash_withdrawal)",
            "amount spikes compared to customer's daily average"
        ]
    },
    "currency": {
        "importance_weight": 0.65,
        "behaviour_rules": [
            "currency not matching typical currency for channel (e.g., JPY in cash withdrawal in CH)",
            "currency conversion without fx_indicator set"
        ]
    },
    "channel": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "high-risk channel (FAST, FPS) used for large amounts",
            "channel inconsistent with product_type"
        ]
    },
    "product_type": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "product_type 'cash_deposit' with amount > 100,000",
            "product_type 'fx_conversion' without fx details"
        ]
    },
    "originator_name": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "originator_name appears in watch-list",
            "same name used across many unrelated accounts"
        ]
    },
    "originator_account": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "originator_account reused for many beneficiaries",
            "account format invalid for country"
        ]
    },
    "originator_country": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "high-risk originator_country (e.g., IR, RU, CN) combined with high amount",
            "originator_country differs from booking_jurisdiction without justification"
        ]
    },
    "beneficiary_name": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "beneficiary_name matches known PEP or sanction list",
            "beneficiary_name reused across many originators"
        ]
    },
    "beneficiary_account": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "beneficiary_account appears in multiple high-value transactions",
            "account format inconsistent with beneficiary_country"
        ]
    },
    "beneficiary_country": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "beneficiary_country high-risk and amount > threshold",
            "cross-border transaction without proper travel_rule_complete"
        ]
    },
    "swift_mt": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "missing MT code for wire_transfer",
            "unexpected MT code for product_type"
        ]
    },
    "ordering_institution_bic": {
        "importance_weight": 0.45,
        "behaviour_rules": [
            "BIC not matching originator_country",
            "BIC reused across unrelated customers"
        ]
    },
    "beneficiary_institution_bic": {
        "importance_weight": 0.45,
        "behaviour_rules": [
            "BIC not matching beneficiary_country",
            "BIC missing for high-value wire transfers"
        ]
    },
    "swift_f50_present": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "false for transactions that should contain ordering institution details"
        ]
    },
    "swift_f59_present": {
        "importance_weight": 0.3,
        "behaviour_rules": [
            "false for transactions that should contain beneficiary details"
        ]
    },
    "swift_f70_purpose": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "empty when purpose_code is required",
            "purpose text not matching regulatory expectations"
        ]
    },
    "swift_f71_charges": {
        "importance_weight": 0.35,
        "behaviour_rules": [
            "charges field missing for fee-bearing transfers"
        ]
    },
    "travel_rule_complete": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "false for cross-border transfers above 10,000 USD/EUR",
            "false when originator and beneficiary are in different jurisdictions"
        ]
    },
    "fx_indicator": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "true but fx fields empty",
            "false while fx_base_ccy or fx_quote_ccy populated"
        ]
    },
    "fx_base_ccy": {
        "importance_weight": 0.55,
        "behaviour_rules": [
            "base currency not matching originator_currency",
            "base currency high-risk (e.g., CNY) with large amount"
        ]
    },
    "fx_quote_ccy": {
        "importance_weight": 0.55,
        "behaviour_rules": [
            "quote currency not matching beneficiary_currency",
            "quote currency unusual for channel"
        ]
    },
    "fx_applied_rate": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "applied rate deviates >5% from market_rate",
            "rate zero for fx_indicator true"
        ]
    },
    "fx_market_rate": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "market_rate missing when fx_indicator true"
        ]
    },
    "fx_spread_bps": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "spread > 100 bps for low-value fx conversion"
        ]
    },
    "fx_counterparty": {
        "importance_weight": 0.45,
        "behaviour_rules": [
            "counterparty unknown or empty for large fx trades"
        ]
    },
    "customer_id": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "customer_id linked to many high-value transactions across different countries",
            "customer_id reused after account closure"
        ]
    },
    "customer_type": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "individual type with corporate-like transaction patterns",
            "domiciliary_company flagged with high cash activity"
        ]
    },
    "customer_risk_rating": {
        "importance_weight": 0.9,
        "behaviour_rules": [
            "high rating (High) combined with low KYC recency",
            "low rating (Low) but large cross-border transfers"
        ]
    },
    "customer_is_pep": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "true and transaction amount > 50,000",
            "true with missing enhanced due diligence"
        ]
    },
    "kyc_last_completed": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "KYC older than 2 years for high-risk transactions",
            "KYC date after transaction date"
        ]
    },
    "kyc_due_date": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "KYC due date passed and transaction still processed"
        ]
    },
    "edd_required": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "true but edd_performed false for high-value or high-risk transaction"
        ]
    },
    "edd_performed": {
        "importance_weight": 0.75,
        "behaviour_rules": [
            "false when edd_required true",
            "false for transactions > jurisdiction threshold"
        ]
    },
    "sow_documented": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "false for securities_trade or fund_subscription"
        ]
    },
    "purpose_code": {
        "importance_weight": 0.65,
        "behaviour_rules": [
            "purpose_code missing for wire transfers",
            "purpose_code inconsistent with product_type"
        ]
    },
    "narrative": {
        "importance_weight": 0.4,
        "behaviour_rules": [
            "narrative contains generic filler text",
            "narrative length < 10 characters for large amount"
        ]
    },
    "is_advised": {
        "importance_weight": 0.35,
        "behaviour_rules": [
            "false for advisory-required products (e.g., investment funds)"
        ]
    },
    "product_complex": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "true for simple cash deposits"
        ]
    },
    "client_risk_profile": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "profile 'Low' but transaction amount > 500,000",
            "profile 'High' with no supporting documentation"
        ]
    },
    "suitability_assessed": {
        "importance_weight": 0.55,
        "behaviour_rules": [
            "false for investment-type product_type"
        ]
    },
    "suitability_result": {
        "importance_weight": 0.55,
        "behaviour_rules": [
            "result 'false' while product_complex true"
        ]
    },
    "product_has_va_exposure": {
        "importance_weight": 0.45,
        "behaviour_rules": [
            "true for non-VA products"
        ]
    },
    "va_disclosure_provided": {
        "importance_weight": 0.45,
        "behaviour_rules": [
            "false when product_has_va_exposure true"
        ]
    },
    "cash_id_verified": {
        "importance_weight": 0.7,
        "behaviour_rules": [
            "false for cash_deposit amounts > 50,000",
            "false for cash_withdrawal in high-risk jurisdictions"
        ]
    },
    "daily_cash_total_customer": {
        "importance_weight": 0.85,
        "behaviour_rules": [
            "total cash amount for customer > daily limit (e.g., 100,000)",
            "sharp increase compared to previous days"
        ]
    },
    "daily_cash_txn_count": {
        "importance_weight": 0.8,
        "behaviour_rules": [
            "count > 5 for same customer in a single day",
            "multiple cash withdrawals within short interval"
        ]
    },
    "sanctions_screening": {
        "importance_weight": 0.95,
        "behaviour_rules": [
            "false (screening failed) but transaction still processed",
            "true but matches known sanction list"
        ]
    },
    "suspicion_determined_datetime": {
        "importance_weight": 0.6,
        "behaviour_rules": [
            "suspicion timestamp far after booking_datetime (>24h)",
            "missing when other high-risk flags present"
        ]
    },
    "str_filed_datetime": {
        "importance_weight": 0.5,
        "behaviour_rules": [
            "STR filed date later than suspicion_determined_datetime",
            "STR not filed for high-risk transaction"
        ]
    },
    "high_amount_flag": {
        "importance_weight": 0.92,
        "behaviour_rules": [
            "amount > 1,000,000 in any currency",
            "amount > 100,000 for cash_deposit or cash_withdrawal"
        ]
    },
    "cross_border_flag": {
        "importance_weight": 0.88,
        "behaviour_rules": [
            "originator_country != beneficiary_country",
            "travel_rule_complete false while cross-border amount > 10,000"
        ]
    },
    "risk_score": {
        "importance_weight": 0.97,
        "behaviour_rules": [
            "combined weighted score of customer_risk_rating, amount, high_amount_flag, cross_border_flag, sanctions_screening",
            "score > 0.8 triggers suspicion"
        ]
    },
    "fx_rate_deviation_flag": {
        "importance_weight": 0.65,
        "behaviour_rules": [
            "abs(fx_applied_rate - fx_market_rate) / fx_market_rate > 0.05",
            "fx_spread_bps > 100"
        ]
    },
    "cash_activity_intensity": {
        "importance_weight": 0.78,
        "behaviour_rules": [
            "daily_cash_total_customer / daily_cash_txn_count > 20,000",
            "daily_cash_txn_count > 5 within 24h"
        ]
    }
}